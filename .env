# IP of the NFS server
NFS_SERVER_IP=10.14.220.88

# NFS-exported directory path (relative to server)
NFS_MOUNT_DIR=/nfs/logs

# Directory inside the NFS share to monitor (can be any valid path)
# It will be mounted in the container as /host-root/<your path>
AUDIT_DIRECTORY=/host-root/nfs/logs  # <-- Change to any path as needed